# ─── Supabase ──────────────────────────────────────────────
# Public — safe to expose client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-side only. Never read from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Ballot data (Google) ─────────────────────────────────
# Server-side only. Never prefix with NEXT_PUBLIC_.
GOOGLE_CIVIC_API_KEY=
# Optional: override the discovered Civic election ID.
# GOOGLE_CIVIC_ELECTION_ID=
# Ballot provider: google-civic (default) | fixture (fictional data, no
# credentials; never set in production).
# BALLOT_PROVIDER=fixture
# Optional: address suggestions on the landing page (Places API (New)).
GOOGLE_PLACES_API_KEY=
# Monthly caps on Places calls (default 10000 each = Google's free tier).
# Raise to allow paid usage; 0 turns the call off.
# PLACES_AUTOCOMPLETE_MONTHLY_LIMIT=10000
# PLACES_DETAILS_MONTHLY_LIMIT=10000

# ─── Live feed (news + polls crons) ────────────────────────
# Bearer secret for /api/cron/* (Vercel sends it on cron runs).
CRON_SECRET=
# FEEDS_PUBLISH=off   # hold matched items instead of publishing them
# NYT_API_KEY=        # New York Times Article Search API key (developer.nytimes.com); news by candidate name. Server only.

# ─── Unused / future (not read by any code) ────────────────
# News comes from approved outlets' RSS feeds and polls from Wikipedia;
# neither needs a key. Leave these unset.
# GNEWS_API_KEY=
# NEWSDATA_API_KEY=
# NEWSAPI_KEY=
# X_API_KEY=
# X_API_SECRET=
# X_BEARER_TOKEN=
# In-app research pipeline (/api/cron/research). Off unless both are set.
# Production and Preview each get their own key, from their own Claude Console workspace.
# ANTHROPIC_API_KEY=
# AI_SYNTHESIS_ENABLED=on
# Optional: monthly stop in USD (default 40), model overrides (default claude-haiku-5-5).
# AI_MONTHLY_BUDGET_USD=40
# ANTHROPIC_DEFAULT_MODEL=
# ANTHROPIC_EXTRACTION_MODEL=
# Model comparison first (default), publish after the owner's decisions (docs/architecture/MODEL_DECISIONS.md).
# AI_MODE=compare
# Writing rounds read their settings from src/data/research/round.json; AI_COMPARE overrides it.
# AI_COMPARE=claude-haiku-5-5:medium:r1
# ANTHROPIC_MODEL_MEASURE=claude-haiku-5-5:medium
# ANTHROPIC_MODEL_PROFILE=claude-haiku-5-5:medium
# ANTHROPIC_MODEL_OFFICE=claude-haiku-5-5:medium
# ANTHROPIC_MODEL_RACE=claude-haiku-5-5:medium
# ANTHROPIC_MODEL_REVIEW=claude-haiku-5-5:medium
# AI_HIGHLIGHTS=on
# ANTHROPIC_MODEL_CHECK=claude-haiku-5-5:high
# AI_CHECK_COMPARE=claude-haiku-5-5:high,claude-sonnet-5-5:low
# ANTHROPIC_SEARCH_MODEL=claude-haiku-5-5
# AI_MAX_INFLIGHT=12
